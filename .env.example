# Copy this file to .env and fill in your own keys. Never commit .env.
GROQ_API_KEY=
GNANI_API_KEY=
# Optional: only needed if you choose a Gemini model with --model or HELPER_MODEL
GEMINI_API_KEY=
# Optional: model for query rewriting and reply labelling (default: openai/gpt-oss-20b on Groq)
HELPER_MODEL=